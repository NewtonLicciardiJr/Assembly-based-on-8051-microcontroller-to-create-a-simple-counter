   28 0000                      org      000h            ;inicio do codigo assembly em 000h
   29 0000 7400                 mov      a,     #0h      ;inicia o acumulador do kit com 0h
   30 0002              inicio:    
   31 0002 2401                 add      a,     #01h     ;incrementa o acumulador
   32 0004 D4                   da       a               ;faz o ajuste BCD do valor no acumulador
   33 0005 FC                   mov      r4,    a        ; v3 -- faz uma cópia de a em r4
   34 0006 7499                 mov      a,     #099h    ; v3 -- carrega 99 no acumulador 
   35 0008 C3                   clr      c               ; v3 -- limpa carry para subtração simples
   36 0009 9C                   subb     a,     r4       ; v3 -- executa "99" -r4
   37 000A              
   38 000A C290                 clr     p1.0             ;liga o buzzer
   39 000C 1184                 acall   delay            ; chama rotina de delay
   40 000E D290                 setb    p1.0             ;desliga o buzzer
