   87 0046              loop2:
   88 0046 00                   nop                     ; esta instru??o leva 1 ciclo de maquina - 1us
   89 0047 DAFD                 djnz    r2,     loop2   ; esta instru??o leva 2 ciclos de maquina - 2 us
   90 0049                                              ; esta instru??o decrementa r2, compara se ele ? zero. 
   91 0049                                              ;  se nao for retorna a loop2
   92 0049                                              ;  djnz ? ideal para controle de loops
   93 0049 00                   nop
   94 004A D9F8                 djnz    r1,     loop1
   95 004C 00                   nop
